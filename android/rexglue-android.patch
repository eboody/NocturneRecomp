diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..78bf500
--- a/src/core/fiber_android.cpp
+++ b/b/src/core/fiber_android.cpp
@@ -0,0 +1,86 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android arm64 backend for rex::thread::Fiber.
+ *
+ * Android/bionic does not provide ucontext. This backend uses a tiny AArch64
+ * callee-saved register context switch so fibers stay on the same host thread,
+ * preserving thread-local assumptions in XThread and guest fiber APIs.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <cassert>
+#include <cstdint>
+#include <exception>
+
+namespace rex::thread {
+
+extern "C" void rex_fiber_swap(void* from_context, const void* to_context);
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->is_thread_fiber_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+#if !defined(__aarch64__)
+#error "Android Fiber backend currently supports arm64-v8a/aarch64 only"
+#endif
+
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+  f->stack_.resize(stack_size);
+
+  uintptr_t sp = reinterpret_cast<uintptr_t>(f->stack_.data() + f->stack_.size());
+  sp &= ~uintptr_t(0xF);  // AArch64 requires 16-byte SP alignment.
+
+  f->context_.sp = sp;
+  f->context_.x30 = reinterpret_cast<uintptr_t>(&Fiber::Trampoline);
+  return f;
+}
+
+void Fiber::Trampoline() {
+  Fiber* f = tls_current_;
+  assert(f);
+  f->entry_(f->arg_);
+
+  // The existing POSIX backend has uc_link = nullptr; returning is terminal.
+  std::terminate();
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  assert(target);
+  Fiber* from = tls_current_;
+  assert(from && "ConvertCurrentThread must be called before SwitchTo");
+
+  if (from == target) {
+    return;
+  }
+
+  tls_current_ = target;
+  rex_fiber_swap(&from->context_, &target->context_);
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    if (tls_current_ == this) {
+      tls_current_ = nullptr;
+    }
+  } else {
+    assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  }
+
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
diff --git a/src/core/fiber_android_arm64.S b/src/core/fiber_android_arm64.S
new file mode 100644
index 0000000..0fd045e
--- a/src/core/fiber_android_arm64.S
+++ b/b/src/core/fiber_android_arm64.S
@@ -0,0 +1,72 @@
+#if defined(__ANDROID__) && defined(__aarch64__)
+
+.text
+.align 2
+.global rex_fiber_swap
+.type rex_fiber_swap, %function
+
+// void rex_fiber_swap(void* from, const void* to)
+//
+// Context layout, all uint64_t:
+//   0   x19
+//   8   x20
+//   16  x21
+//   24  x22
+//   32  x23
+//   40  x24
+//   48  x25
+//   56  x26
+//   64  x27
+//   72  x28
+//   80  x29
+//   88  x30/lr
+//   96  sp
+//   104 d8
+//   112 d9
+//   120 d10
+//   128 d11
+//   136 d12
+//   144 d13
+//   152 d14
+//   160 d15
+
+rex_fiber_swap:
+  // Save callee-saved GPRs.
+  stp x19, x20, [x0, #0]
+  stp x21, x22, [x0, #16]
+  stp x23, x24, [x0, #32]
+  stp x25, x26, [x0, #48]
+  stp x27, x28, [x0, #64]
+  stp x29, x30, [x0, #80]
+
+  mov x9, sp
+  str x9, [x0, #96]
+
+  // Save callee-saved FP/SIMD low 64 bits.
+  stp d8,  d9,  [x0, #104]
+  stp d10, d11, [x0, #120]
+  stp d12, d13, [x0, #136]
+  stp d14, d15, [x0, #152]
+
+  // Restore target FP/SIMD.
+  ldp d8,  d9,  [x1, #104]
+  ldp d10, d11, [x1, #120]
+  ldp d12, d13, [x1, #136]
+  ldp d14, d15, [x1, #152]
+
+  // Restore target SP and GPRs.
+  ldr x9, [x1, #96]
+  mov sp, x9
+
+  ldp x19, x20, [x1, #0]
+  ldp x21, x22, [x1, #16]
+  ldp x23, x24, [x1, #32]
+  ldp x25, x26, [x1, #48]
+  ldp x27, x28, [x1, #64]
+  ldp x29, x30, [x1, #80]
+
+  ret
+
+.size rex_fiber_swap, .-rex_fiber_swap
+
+#endif
