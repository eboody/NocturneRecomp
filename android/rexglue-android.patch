diff --git a/src/core/fiber_android.cpp b/src/core/fiber_android.cpp
new file mode 100644
index 0000000..68784d3
--- /dev/null
+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,123 @@
+/**
+ * @file        rex/core/fiber_android.cpp
+ * @brief       Android backend for rex::thread::Fiber.
+ *
+ * Android/bionic does not provide ucontext. This backend preserves C++ stacks by
+ * running each created fiber on a parked pthread and cooperatively handing
+ * execution between fibers with condition variables. It is heavier than
+ * swapcontext, but it provides the stack-preserving behavior required by XDK
+ * fibers without relying on unavailable libc APIs.
+ */
+
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/thread/fiber.h>
+
+#include <algorithm>
+#include <cassert>
+#include <pthread.h>
+
+namespace rex::thread {
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+void Fiber::WaitUntilRunnable() {
+  std::unique_lock<std::mutex> lock(mutex_);
+  cv_.wait(lock, [this] { return runnable_ || destroy_requested_; });
+  runnable_ = false;
+}
+
+void* Fiber::ThreadMain(void* raw) {
+  auto* fiber = static_cast<Fiber*>(raw);
+  tls_current_ = fiber;
+  {
+    std::lock_guard<std::mutex> lock(fiber->mutex_);
+    fiber->started_ = true;
+    fiber->cv_.notify_all();
+  }
+
+  fiber->WaitUntilRunnable();
+  if (!fiber->destroy_requested_) {
+    fiber->entry_(fiber->arg_);
+  }
+
+  {
+    std::lock_guard<std::mutex> lock(fiber->mutex_);
+    fiber->finished_ = true;
+    fiber->cv_.notify_all();
+  }
+  return nullptr;
+}
+
+Fiber* Fiber::ConvertCurrentThread() {
+  auto* f = new Fiber();
+  f->thread_ = pthread_self();
+  f->is_thread_fiber_ = true;
+  f->started_ = true;
+  tls_current_ = f;
+  return f;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  auto* f = new Fiber();
+  f->entry_ = entry;
+  f->arg_ = arg;
+
+  pthread_attr_t attr;
+  if (pthread_attr_init(&attr) != 0) {
+    delete f;
+    return nullptr;
+  }
+  const size_t min_stack = static_cast<size_t>(PTHREAD_STACK_MIN);
+  pthread_attr_setstacksize(&attr, std::max(stack_size, min_stack));
+  const int rc = pthread_create(&f->thread_, &attr, Fiber::ThreadMain, f);
+  pthread_attr_destroy(&attr);
+  if (rc != 0) {
+    delete f;
+    return nullptr;
+  }
+
+  std::unique_lock<std::mutex> lock(f->mutex_);
+  f->cv_.wait(lock, [f] { return f->started_; });
+  return f;
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  assert(from && target);
+  {
+    std::lock_guard<std::mutex> lock(target->mutex_);
+    target->runnable_ = true;
+    target->cv_.notify_all();
+  }
+  tls_current_ = target;
+  if (!from->finished_) {
+    from->WaitUntilRunnable();
+  }
+  tls_current_ = from;
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    if (tls_current_ == this) {
+      tls_current_ = nullptr;
+    }
+    delete this;
+    return;
+  }
+
+  assert(this != tls_current_ && "Destroy called on the currently running fiber");
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    destroy_requested_ = true;
+    runnable_ = true;
+    cv_.notify_all();
+  }
+  pthread_join(thread_, nullptr);
+  delete this;
+}
+
+}  // namespace rex::thread
+
+#endif  // REX_PLATFORM_ANDROID
