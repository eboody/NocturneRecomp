diff --git a/src/ui/window_android.cpp b/src/ui/window_android.cpp
new file mode 100644
index 0000000..0d49843
--- /dev/null
+++ b/src/ui/window_android.cpp
@@ -0,0 +1,60 @@
+#include <rex/platform.h>
+#if REX_PLATFORM_ANDROID
+
+#include <rex/ui/surface_android.h>
+#include <rex/ui/window_android.h>
+#include <rex/ui/windowed_app_context_android.h>
+
+namespace rex::ui {
+
+std::unique_ptr<Window> Window::Create(WindowedAppContext& app_context,
+                                      const std::string_view title,
+                                      uint32_t desired_logical_width,
+                                      uint32_t desired_logical_height) {
+  return std::make_unique<AndroidWindow>(app_context, title, desired_logical_width,
+                                         desired_logical_height);
+}
+
+bool AndroidWindow::OpenImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  uint32_t width = 1280;
+  uint32_t height = 720;
+  if (auto* ctx = dynamic_cast<AndroidWindowedAppContext*>(&app_context())) {
+    if (ANativeWindow* native_window = ctx->native_window()) {
+      width = static_cast<uint32_t>(ANativeWindow_getWidth(native_window));
+      height = static_cast<uint32_t>(ANativeWindow_getHeight(native_window));
+    }
+  }
+  OnActualSizeUpdate(width, height, destruction_receiver);
+  if (!destruction_receiver.IsWindowDestroyedOrClosed()) {
+    OnFocusUpdate(true, destruction_receiver);
+  }
+  return !destruction_receiver.IsWindowDestroyed();
+}
+
+void AndroidWindow::RequestCloseImpl() {
+  WindowDestructionReceiver destruction_receiver(this);
+  OnBeforeClose(destruction_receiver);
+  if (!destruction_receiver.IsWindowDestroyed()) {
+    OnAfterClose();
+  }
+}
+
+std::unique_ptr<Surface> AndroidWindow::CreateSurfaceImpl(Surface::TypeFlags allowed_types) {
+  if (!(allowed_types & Surface::kTypeFlag_AndroidNativeWindow)) {
+    return nullptr;
+  }
+  auto* ctx = dynamic_cast<AndroidWindowedAppContext*>(&app_context());
+  if (!ctx || !ctx->native_window()) {
+    return nullptr;
+  }
+  return std::make_unique<AndroidNativeWindowSurface>(ctx->native_window());
+}
+
+void AndroidWindow::RequestPaintImpl() {
+  OnPaint(false);
+}
+
+}  // namespace rex::ui
+
+#endif  // REX_PLATFORM_ANDROID
diff --git a/src/ui/windowed_app_context_android.cpp b/src/ui/windowed_app_context_android.cpp
